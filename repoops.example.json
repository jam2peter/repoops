{
  "repository_admin": {
    "owner": "example-owner",
    "owner_type": "user",
    "allowed_author_associations": ["OWNER"],
    "default_description": "Managed by RepoOps",
    "auto_init": true,
    "has_issues": true,
    "has_projects": true,
    "has_wiki": false,
    "delete_branch_on_merge": true
  },
  "project_sync": {
    "project_owner": {
      "type": "user",
      "login": "example-owner"
    },
    "project_number": 1,
    "repositories": [
      "example-owner/repository-a",
      "example-owner/repository-b"
    ],
    "metadata_marker": "REPOOPS",
    "fields": {
      "status": {
        "name": "Status",
        "metadata_key": "status",
        "default_open": "Todo",
        "closed": "Done"
      },
      "project": {
        "name": "Project",
        "metadata_key": "project"
      },
      "repository": {
        "name": "Repository",
        "auto_create_text": true
      },
      "operator": {
        "name": "Operator",
        "metadata_key": "operator",
        "default": "Unassigned",
        "auto_create_text": true
      },
      "start_date": {
        "name": "Start date",
        "metadata_key": "start_date"
      },
      "target_date": {
        "name": "Target date",
        "metadata_key": "target_date"
      }
    },
    "operator_labels": {
      "operator:automation": "Automation",
      "operator:human": "Human"
    }
  }
}
